#!/usr/bin/env bash
# Print the CDP websocket URL of this host's Brave Origin, for agent-browser:
#   brave-browser runs agent-browser through it.
# Brave Origin writes its debugging port and path to DevToolsActivePort once remote debugging is on, and asks the person
# at this machine to Allow each new connection.
set -euo pipefail
if [[ ${1-} == -h || ${1-} == --help ]]; then
  sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'
  exit 0
fi
f=$HOME/.config/BraveSoftware/Brave-Origin/DevToolsActivePort
[[ -r $f ]] || { echo "brave-cdp: turn on brave://inspect/#remote-debugging in Brave Origin" >&2; exit 1; }
echo "ws://127.0.0.1:$(sed -n 1p "$f")$(sed -n 2p "$f")"
