#!/usr/bin/env bash
# Run agent-browser against a shared signed-in browser, each session in its own pinned tab.
#   box-browser [--session NAME] [--on HOST] COMMAND...
#       the box browser: this host's when it runs box-browser.service, else devbox's over SSH; --on names the host
#   box-browser [--session NAME] --brave COMMAND...
#       Omer's Brave: this host's Brave Origin
#   box-browser [--session NAME] [--on HOST] --app ACCOUNT COMMAND...
#       the Grok Bot app signed in to ACCOUNT (personal or company), found like the box browser; its sessions share
#       the app's one window. The app starts with the first command and stops after 30 min with no connection.
#   box-browser [--on HOST] [--app ACCOUNT] status
#   box-browser [--on HOST] --app ACCOUNT start
# The session is NAME, else AGENT_BROWSER_SESSION, else CLAUDE_CODE_SESSION_ID, else CODEX_THREAD_ID.
# On the box browser, `close` closes the session's tab, then ends the session.
# The first --brave call of a session waits up to 10 min for Omer to click Allow in Brave. Write `close` as the first
# word of COMMAND, so it skips that wait.
set -euo pipefail

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }
fail_usage() {
  usage >&2
  exit 2
}

session=${AGENT_BROWSER_SESSION:-${CLAUDE_CODE_SESSION_ID:-${CODEX_THREAD_ID:-}}}
on=
app=
brave=false
while (($#)); do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    --session | --on | --app)
      [[ -n ${2-} && $2 != -* ]] || fail_usage
      case $1 in
        --on) on=$2 ;;
        --app) app=$2 ;;
        *) session=$2 ;;
      esac
      shift 2
      ;;
    --session=* | --on=* | --app=*)
      [[ -n ${1#*=} ]] || fail_usage
      case $1 in
        --on=*) on=${1#*=} ;;
        --app=*) app=${1#*=} ;;
        *) session=${1#*=} ;;
      esac
      shift
      ;;
    --brave)
      brave=true
      shift
      ;;
    *) break ;;
  esac
done
(($#)) || fail_usage
args=()
while (($#)); do
  case $1 in
    --session)
      [[ -n ${2-} ]] || fail_usage
      session=$2
      shift 2
      ;;
    --session=*)
      session=${1#*=}
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
set -- "${args[@]}"
[[ -z $on || $on =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]] || {
  echo "box-browser: $on is not a host name" >&2
  exit 2
}

[[ -z $app || $app =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
  echo "box-browser: $app is not an account name" >&2
  exit 2
}
if $brave && [[ -n $app ]]; then fail_usage; fi

cdp_port=9344
box_name="box browser"
box_units=(box-display box-browser)
target=()
if [[ -n $app ]]; then
  box_name="Grok Bot app for the account $app"
  box_units=("grok-bot-display-$app" "grok-bot-wm-$app" "grok-bot-box-$app")
  target=(--app "$app")
  port_file=/etc/grok-bot-box/$app.port
fi
box_unit=/etc/systemd/user/${box_units[-1]}.service

need_session() {
  [[ -n $session ]] || {
    echo "box-browser: no session name; pass --session NAME or set AGENT_BROWSER_SESSION" >&2
    exit 2
  }
  [[ $session =~ ^[A-Za-z0-9_-]+$ ]] || {
    echo "box-browser: a session name holds only letters, digits, - and _" >&2
    exit 2
  }
}

local_box() {
  case $on in
    '') [[ -e $box_unit ]] ;;
    local | "$(uname -n)")
      [[ -e $box_unit ]] || {
        echo "box-browser: $(uname -n) runs no $box_name" >&2
        exit 1
      }
      ;;
    *) false ;;
  esac
}

use_app_port() {
  [[ -n $app ]] || return 0
  [[ -r $port_file && $(< "$port_file") =~ ^[0-9]+$ ]] || {
    echo "box-browser: $port_file does not hold the DevTools port of the $box_name" >&2
    exit 1
  }
  cdp_port=$(< "$port_file")
}

session_running() {
  local list
  list=$(agent-browser session list) || return 2
  awk 'NR > 1 { print $NF }' <<< "$list" | grep -qxF -- "$session"
}

# agent-browser keeps a session's tab pin after the session ends (`agent-browser tab --help`), so a session whose pinned
# tab closed fails with tab_gone on its next command until it opens a new tab.
reopen_pinned_tab() {
  local err
  if ! err=$(agent-browser "$@" get url 2>&1 > /dev/null) && [[ $err == *tab_gone* ]]; then
    agent-browser "$@" tab new > /dev/null
  fi
}

# Chromium refuses to close its last tab, so that tab is blanked instead, which leaves no signed-in page open.
close_session_tab() {
  local err
  err=$(agent-browser tab close 2>&1 > /dev/null) && return
  case $err in
    *tab_gone*) ;;
    *"last tab"*) agent-browser open about:blank > /dev/null ;;
    *)
      printf '%s\n' "$err" >&2
      return 1
      ;;
  esac
}

command_name() {
  local flags arg takes_value=
  [[ " $* " == *" close "* ]] || return 0
  flags=$(agent-browser --help | sed -n 's/^  \(--[a-z-]*\) <.*/\1/p')
  for arg in "$@"; do
    if [[ -n $takes_value ]]; then
      takes_value=
    elif [[ $arg == -* ]]; then
      if grep -qxF -- "$arg" <<< "$flags"; then takes_value=1; fi
    else
      printf '%s\n' "$arg"
      return 0
    fi
  done
}

app_devtools() {
  curl --silent --fail --max-time 1 --output /dev/null "http://127.0.0.1:$cdp_port/json/version"
}

# Records the use for the idle check, starts the app unless it runs, and waits for DevTools.
start_app() {
  local unit=${box_units[-1]}.service
  grok-bot-box-idle used "$app"
  if ! systemctl --user is-active --quiet "$unit"; then
    systemctl --user start "$unit" || {
      echo "box-browser: the $box_name did not start; read journalctl --user -u $unit" >&2
      exit 1
    }
  fi
  for _ in {1..150}; do
    if app_devtools; then return 0; fi
    sleep 0.2
  done
  echo "box-browser: the $box_name runs, but DevTools did not answer on 127.0.0.1:$cdp_port" >&2
  exit 1
}

box_status() {
  local failed=0 unit
  if [[ -n $app ]] && ! systemctl --user is-active --quiet "${box_units[@]/%/.service}" &&
    ! systemctl --user is-failed --quiet "${box_units[@]/%/.service}"; then
    echo "$box_name: stopped; the next command for this account starts it"
    return 0
  fi
  for unit in "${box_units[@]}"; do
    if systemctl --user is-active --quiet "$unit.service"; then
      echo "$unit: active"
    else
      echo "$unit: not active" >&2
      failed=1
    fi
  done
  if curl --silent --fail --max-time 5 --output /dev/null "http://127.0.0.1:$cdp_port/json/version"; then
    echo "CDP: answers on 127.0.0.1:$cdp_port"
  else
    echo "CDP: no answer on 127.0.0.1:$cdp_port" >&2
    failed=1
  fi
  return "$failed"
}

# The remote login shell may be zsh, which expands a word that starts with `=` even when bash's %q left it bare, so
# each argument goes in single quotes.
remote_box() {
  local host=${on:-devbox} arg quoted=
  for arg in --on local "$@"; do
    quoted+=" '${arg//\'/\'\\\'\'}'"
  done
  exec ssh -o BatchMode=yes -- "$host" "box-browser$quoted"
}

# Brave Origin writes its debugging port and path to DevToolsActivePort once remote debugging is on; its /json
# answers 404, so the path comes from that file.
brave_ws() {
  local f=$HOME/.config/BraveSoftware/Brave-Origin/DevToolsActivePort
  [[ -r $f ]] || {
    echo "box-browser: turn on brave://inspect/#remote-debugging in Brave Origin" >&2
    exit 1
  }
  echo "ws://127.0.0.1:$(sed -n 1p "$f")$(sed -n 2p "$f")"
}

if ! $brave; then
  if [[ $1 == status || (-n $app && $1 == start) ]]; then
    if ! local_box; then remote_box "${target[@]}" "$1"; fi
    use_app_port
    if [[ $1 == start ]]; then start_app; else box_status; fi
    exit
  fi
  need_session
  [[ $session != brave_* && $session != app_* ]] || {
    echo "box-browser: session names that start with brave_ or app_ belong to --brave and --app" >&2
    exit 2
  }
  local_box || remote_box "${target[@]}" --session "$session" "$@"
  if [[ -n $app ]]; then
    use_app_port
    unset AGENT_BROWSER_PIN_TAB
    export AGENT_BROWSER_SESSION=app_${app}_$session AGENT_BROWSER_CDP=$cdp_port AGENT_BROWSER_IDLE_TIMEOUT_MS=600000
    if [[ $(command_name "$@") != close ]]; then
      start_app
      # DevTools answers before the app has drawn its chat or its sign-in screen.
      agent-browser wait --fn 'document.querySelector("[role=textbox]") !== null ||
        [...document.querySelectorAll("button")].some((button) => button.textContent.trim() === "Sign in")' > /dev/null
    fi
    exec agent-browser "$@"
  fi
  export AGENT_BROWSER_SESSION=$session AGENT_BROWSER_CDP=$cdp_port AGENT_BROWSER_PIN_TAB=1
  if [[ $(command_name "$@") == close ]]; then
    status=0
    running=0
    session_running || running=$?
    case $running in
      0) close_session_tab || status=$? ;;
      1) ;;
      *) status=1 ;;
    esac
    agent-browser "$@" || status=$?
    exit "$status"
  fi
  reopen_pinned_tab
  exec agent-browser "$@"
fi

[[ -z $on ]] || {
  echo "box-browser: --brave drives only this host's Brave Origin; run it on the PC Omer sits at" >&2
  exit 2
}
systemctl --user --quiet is-active graphical-session.target || {
  echo "box-browser: $(uname -n) has no desktop session, so no Brave; --brave runs only on the PC Omer sits at" >&2
  exit 1
}
need_session
session=brave_$session
export AGENT_BROWSER_SESSION=$session
state=${XDG_RUNTIME_DIR:?}/box-browser
mkdir -p "$state"
attached=$state/$session.attached
exec 9> "$state/$session.lock"
if ! flock -n 9; then
  echo "box-browser: waiting for another call of session $session" >&2
  flock 9
fi

# `close` runs without --cdp, because with --cdp a session that has no daemon would attach again and wait for Allow.
if [[ $(command_name "$@" 9>&-) == close ]]; then
  status=0
  agent-browser "$@" 9>&- || status=$?
  rm -f "$attached"
  exit "$status"
fi

ws=$(brave_ws)

# Every other call passes --cdp: a session whose attach failed would otherwise launch a local browser on its next
# command. agent-browser lists a session as soon as its daemon starts, before Allow. Brave holds the CDP connection
# open until Allow, and agent-browser's client stops reading after 30 s with "os error 11" while its daemon keeps
# waiting on that connection. A repeat call joins the pending connection instead of opening a new one, so retrying
# gives the 10 min wait without a second Allow dialog. Each agent-browser call closes fd 9, so a daemon it starts does
# not hold the lock.
if [[ ! -e $attached || $(< "$attached") != "$ws" ]] || ! session_running 9>&-; then
  rm -f "$attached"
  echo "box-browser: waiting for Allow in Brave on $(uname -n)" >&2
  deadline=$((SECONDS + 600))
  until err=$(agent-browser --pin-tab --cdp "$ws" wait --fn true 2>&1 > /dev/null 9>&-); do
    if [[ $err == *tab_gone* && -z ${new_tab-} ]]; then
      new_tab=1
      reopen_pinned_tab --cdp "$ws" 9>&-
      continue
    fi
    if [[ $err != *"(os error 11)"* ]] || ((SECONDS >= deadline)); then
      printf '%s\n' "$err" >&2
      exit 1
    fi
  done
  # Brave leaves a background tab that CDP created without a working page, so the attach brings it to the front.
  tab=$(agent-browser --cdp "$ws" --json tab list 9>&- | jq -r '.data.tabs[] | select(.active) | .targetId')
  agent-browser --cdp "$ws" tab "$tab" > /dev/null 9>&-
  printf '%s' "$ws" > "$attached"
fi
exec 9>&-
reopen_pinned_tab --cdp "$ws"
exec agent-browser --cdp "$ws" "$@"
