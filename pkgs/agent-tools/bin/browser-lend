#!/usr/bin/env bash
# Lend this machine's logged-in Chromium browser (Brave, Chrome, Chromium, Edge) to agents on devbox, on Linux or
# macOS, only while a task needs it. The Windows version is browser-lend.ps1.
#   browser-lend on [name]   forward a loopback port on devbox to the browser's DevTools port over SSH; [name] picks a
#                            browser whose profile folder contains it, e.g. chrome
#   browser-lend off         stop the forward
#   browser-lend status      show whether this machine lends a browser
# First turn on remote debugging at <browser>://inspect/#remote-debugging. On devbox an agent connects with
# box-browser --brave --on <this machine>, and the browser asks you to Allow it.
# DevTools has no password: while it is on, every process of the SSH user on devbox, and root there, can drive this
# browser. BROWSER_LEND_HOST names another SSH destination than devbox.
set -euo pipefail
help_text() { sed -n 4,7p "$0" | sed 's/^# *//'; }
if [[ ${1-} == -h || ${1-} == --help ]]; then
  help_text
  exit 0
fi

host=${BROWSER_LEND_HOST:-devbox}
me=$(hostname -s)
sock=$HOME/.ssh/browser-lend.sock
lent=.local/state/browser-lend/$me
if [[ $(uname) == Darwin ]]; then
  base="$HOME/Library/Application Support"
  dirs=(BraveSoftware/Brave-Browser Google/Chrome Chromium "Microsoft Edge")
else
  base="${XDG_CONFIG_HOME:-$HOME/.config}"
  dirs=(BraveSoftware/Brave-Origin BraveSoftware/Brave-Browser google-chrome chromium microsoft-edge)
fi

listening() { (exec 3<> "/dev/tcp/127.0.0.1/$1") 2> /dev/null; }

active_port_file() {
  local d f
  while IFS= read -r f; do
    [[ -n ${1:-} ]] && ! grep -qi -- "$1" <<< "$f" && continue
    listening "$(sed -n 1p "$f")" && { echo "$f"; return; }
  done < <(for d in "${dirs[@]}"; do f="$base/$d/DevToolsActivePort"; [[ -s $f ]] && echo "$(stat -c %Y "$f" 2> /dev/null || stat -f %m "$f") $f"; done | sort -rn | cut -d' ' -f2-)
  return 1
}

lending() { ssh -S "$sock" -O check "$host" 2> /dev/null; }
stop_master() {
  ssh -S "$sock" -O exit "$host" 2> /dev/null || true
  rm -f "$sock"
}

case "${1:-}" in
  on)
    # A `!` command in an agent session on the box runs on the box, not on the machine whose browser it means.
    [[ $me != devbox ]] || { echo "browser-lend: this is devbox, where agents connect; run browser-lend on in a terminal on the machine whose browser you lend, such as nixos-desktop" >&2; exit 1; }
    f=$(active_port_file "${2:-}") || { echo "browser-lend: no browser with remote debugging on; turn it on at <browser>://inspect/#remote-debugging" >&2; exit 1; }
    ! lending || { echo "browser-lend: already lending; run browser-lend off first" >&2; exit 1; }
    rm -f "$sock"
    ssh -f -N -M -S "$sock" -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes "$host"
    trap stop_master EXIT
    # A remote forward to port 0 makes sshd pick a free port, and `-O forward` prints it.
    port=$(ssh -S "$sock" -O forward -R "127.0.0.1:0:127.0.0.1:$(sed -n 1p "$f")" "$host")
    printf '%s %s\n' "$port" "$(sed -n 2p "$f")" | ssh -S "$sock" "$host" "umask 077; mkdir -p ${lent%/*} && cat > $lent"
    trap - EXIT
    echo "browser-lend: lending ${f%/DevToolsActivePort}; on $host run box-browser --brave --on $me"
    ;;
  off)
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" "rm -f $lent" || echo "browser-lend: could not remove $lent on $host" >&2
    stop_master
    echo "browser-lend: off"
    ;;
  status)
    if lending; then echo on; else echo off; fi
    ;;
  *)
    help_text >&2
    exit 2
    ;;
esac
