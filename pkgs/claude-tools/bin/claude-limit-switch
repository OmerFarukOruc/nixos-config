#!/usr/bin/env python3
# Keeps Claude Code agents in herdr running: moves an agent to another account when its account hits a usage
# limit, and starts the agents again after the herdr server restarted.
#   claude-limit-switch scan                        restore, then switch each named Claude agent whose screen ends
#                                                   in a limit message (claude-limit-switch.timer runs this)
#   claude-limit-switch restore                     only the restore step of scan
#   claude-limit-switch switch NAME [--to ACCOUNT]  switch one agent now
#   claude-limit-switch resume NAME                 start a recorded agent that is not running, such as one that
#                                                   ended by an accidental /exit
#   claude-limit-switch usage [ACCOUNT ...]         print the session and weekly meters of each account
# Accounts are the claude-accounts accounts. They share ~/.claude/projects, so `claude --resume <session>`
# continues the same conversation under another account. A switch types /exit in the agent's pane, sets
# CLAUDE_CONFIG_DIR there, starts Claude like `clauded --resume <session>` with its other old arguments under the same agent
# name, and tells the agent to continue. ~/.config/claude-limit-switch/resume/NAME replaces that message for
# agent NAME. `--resume` brings back a fixed-interval /loop but not a self-paced one or a Monitor, so an agent that
# runs them needs a message that checks CronList first (the dotfiles checkout's desktop/reference/unattended-agents.md).
# scan holds the account back in claude-usage's hold file until the reset that the limit message names, and moves the
# agent to the account that claude-usage's next_account picks after it reads the usage of each account not held
# back. When that is the agent's own account, because its limit has reset, scan only sends the resume message.
# herdr itself resumes Claude as plain `claude --resume`, without the flag and the account (see
# the dotfiles checkout's desktop/reference/headless-clis/herdr.md), so its own restore is off. Instead each scan records the named Claude
# agents and the server process in agents.json. When the next scan finds a different server process, it starts each
# recorded agent that is missing like `clauded --resume <session>` with its account, in its old pane or a new
# workspace, and sends it the resume message. An agent that is missing while the same server runs was ended on
# purpose; the record keeps it under "ended" with its last session for ENDED_KEEP, and only `resume NAME` starts it
# again, the same way. A start that fails closes the workspace it made, and the next try waits COOLDOWN. When no
# server runs, scan starts it (herdr-default.service for the default session).
# State is in ~/.local/state/claude-limit-switch: agents.json, switched.json and restore-failed.json (name: time of the
# last try), and events.log with the one before it in events.log.1. The holds after a limit are in
# ~/.local/state/claude-accounts/limits.json, which claude-rotate shares. CLAUDE_LIMIT_SWITCH_STATE,
# CLAUDE_ACCOUNTS_STATE and CLAUDE_LIMIT_SWITCH_SESSION (a herdr session name) point a test elsewhere.
from __future__ import annotations

import argparse
import fcntl
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import datetime
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

HOME = Path.home()
BIN = Path(__file__).resolve().parent
STATE = Path(os.environ.get("CLAUDE_LIMIT_SWITCH_STATE") or HOME / ".local/state/claude-limit-switch")
SESSION = os.environ.get("CLAUDE_LIMIT_SWITCH_SESSION", "")
RESUME = HOME / ".config/claude-limit-switch/resume"
USAGE = BIN / "claude-usage"
# scan skips an agent this long after a move it tried, and restore waits this long after a failed start. After a
# switch the screen keeps the old limit message until the agent answers; after a move with no room or a failed
# start, scan runs every minute and would otherwise try again on each run.
COOLDOWN = 300
EVENTS_MAX = 1 << 20
ENDED_KEEP = 30 * 86400
SKIP_PERMISSIONS = "--dangerously-skip-permissions"
READY_WAIT_S = 180
TAIL = 6


def load_tool(name: str):
    loader = SourceFileLoader(name.replace("-", "_"), str(BIN / name))
    mod = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


cu = load_tool("claude-usage")


def find_limit(screen: str) -> str | None:
    """The limit message among the last lines above Claude's input box, or None."""
    lines = screen.splitlines()
    end = len(lines)
    for i in range(len(lines) - 1, 0, -1):
        if lines[i].lstrip().startswith("❯") and lines[i - 1].lstrip().startswith("─"):
            end = i - 1
            break
    for line in reversed([x for x in lines[:end] if x.strip()][-TAIL:]):
        if cu.parse_limit(line, cu.now()):
            return line.strip()
    return None


def resume_args(argv: list[str], session: str) -> list[str]:
    """The arguments that resume a session the way `clauded --resume` does: Omer's `clauded` alias adds
    --dangerously-skip-permissions, so an agent never stops at a permission prompt after a switch."""
    out, skip = [] if SKIP_PERMISSIONS in argv else [SKIP_PERMISSIONS], False
    for a in argv:
        if skip:
            skip = False
        elif a in ("--resume", "-r"):
            skip = True
        elif a not in ("--continue", "-c") and not a.startswith("--resume="):
            out.append(a)
    return [*out, "--resume", session]


def to_restore(record: dict, live: set[str], server: str | None) -> list[str]:
    if not server or not record or record.get("server") == server:
        return []
    return [n for n in record.get("agents", {}) if n not in live]


class Failed(Exception):
    pass


def next_record(record: dict, agents: dict, server: str, failed: list[str], now: float) -> dict:
    """The new agents.json from the live agents. An agent whose restore failed stays live under the old server id,
    so the next scan tries again. Any other recorded agent that is gone moves to "ended", which keeps an entry for
    ENDED_KEEP."""
    old = record.get("agents", {})
    for n in failed:
        agents.setdefault(n, old[n])
    ended = {n: {**r, "ended_at": r.get("ended_at", now)} for n, r in record.get("ended", {}).items()
             if n not in agents and r.get("ended_at", now) > now - ENDED_KEEP}
    ended.update({n: {**r, "ended_at": now} for n, r in old.items() if n not in agents})
    return {"server": record.get("server") if failed else server, "agents": agents, "ended": ended}


def recorded(record: dict, name: str) -> dict:
    found = record.get("agents", {}).get(name) or record.get("ended", {}).get(name)
    if found is None:
        known = sorted({*record.get("agents", {}), *record.get("ended", {})})
        raise Failed(f"no record of {name}; recorded: {', '.join(known) or 'none'}")
    return found


HERDR = shutil.which("herdr") or "/usr/local/bin/herdr"
HERDR_CMD = [HERDR, *(["--session", SESSION] if SESSION else [])]


def herdr(*args: str, check: bool = True) -> dict:
    p = subprocess.run([*HERDR_CMD, *args], capture_output=True, text=True, timeout=300, check=False)
    try:
        data = json.loads(p.stdout or p.stderr or "{}")
    except json.JSONDecodeError:
        data = {}
    if check and p.returncode != 0:
        err = data.get("error") or {}
        raise Failed(f"herdr {args[0]} {args[1]}: {err.get('code') or p.stderr.strip()[:200]}")
    return data


def error_code(e: Failed) -> str:
    return str(e).rsplit(": ", 1)[-1]


def screen_of(name: str, source: str = "visible", lines: int = 0) -> str:
    args = [*HERDR_CMD, "agent", "read", name, "--source", source, *(["--lines", str(lines)] if lines else [])]
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=60, check=False).stdout
    except subprocess.TimeoutExpired:
        return ""


def account_of(config_dir: str, dirs: dict[str, str]) -> str:
    if config_dir in ("", str(HOME / ".claude")):
        config_dir = ""
    for n, d in dirs.items():
        if d == config_dir.rstrip("/"):
            return n
    raise Failed(f"CLAUDE_CONFIG_DIR={config_dir!r} is no claude-accounts account")


def socket_path() -> str:
    base = HOME / ".config/herdr"
    return str(base / "sessions" / SESSION / "herdr.sock" if SESSION else base / "herdr.sock")


def server_id() -> str | None:
    """pid:start-time of this session's herdr server process, so a restarted server gets a new id."""
    want = ["--session", SESSION, "server"] if SESSION else ["server"]
    for p in Path("/proc").iterdir():
        try:
            if not p.name.isdigit():
                continue
            argv = (p / "cmdline").read_bytes().decode().split("\0")[:-1]
            if argv and Path(argv[0]).name == "herdr" and argv[1:] == want:
                return f"{p.name}:{(p / 'stat').read_text().rsplit(')', 1)[1].split()[19]}"
        except OSError:
            continue
    return None


def ensure_server() -> str:
    if server := server_id():
        return server
    if SESSION:
        subprocess.Popen([*HERDR_CMD, "server"], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd=HOME)
    else:
        subprocess.run(["systemctl", "--user", "start", "herdr-default.service"], check=False)
    deadline = time.time() + 30
    while time.time() < deadline:
        if (server := server_id()) and "result" in herdr("agent", "list", check=False):
            log(f"started the herdr server{' for session ' + SESSION if SESSION else ''}")
            return server
        time.sleep(1)
    raise Failed("the herdr server did not start in 30 s")


def claude_process(pane: str) -> tuple[int, list[str], str]:
    """The Claude process in a pane: pid, argv, CLAUDE_CONFIG_DIR."""
    sock = socket_path()
    for p in Path("/proc").iterdir():
        try:
            if not p.name.isdigit() or (p / "comm").read_text().strip() not in ("claude", ".claude-wrapped"):
                continue
            env = dict(x.split("=", 1) for x in (p / "environ").read_bytes().decode().split("\0") if "=" in x)
            if env.get("HERDR_PANE_ID") == pane and env.get("HERDR_SOCKET_PATH") == sock:
                return int(p.name), (p / "cmdline").read_bytes().decode().split("\0")[:-1], env.get("CLAUDE_CONFIG_DIR", "")
        except OSError:
            continue
    raise Failed(f"no claude process in pane {pane}")


def gone(pid: int, seconds: float) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        if not Path(f"/proc/{pid}").exists():
            return True
        time.sleep(0.5)
    return False


def exit_claude(name: str, pid: int) -> None:
    herdr("agent", "send-keys", name, "esc", check=False)
    time.sleep(1)
    herdr("agent", "prompt", name, "/exit", check=False)
    # With a scheduled task, /exit opens "Background work is running"; match its selected first choice, so a
    # screen that only quotes the dialog gets no Enter.
    # `claude --resume` brings a fixed-interval /loop back after that choice.
    deadline = time.time() + 10
    while not gone(pid, 1) and time.time() < deadline:
        if "❯ 1. Exit and stop tasks" in screen_of(name):
            herdr("agent", "send-keys", name, "enter", check=False)
            log(f"answered the background-work dialog of {name} with Exit and stop tasks")
            break
    if not gone(pid, 30):
        herdr("agent", "send-keys", name, "ctrl+c", check=False)
        time.sleep(0.5)
        herdr("agent", "send-keys", name, "ctrl+c", check=False)
        if not gone(pid, 15):
            raise Failed(f"claude pid {pid} of {name} did not exit")
    wait_freed(name)


def wait_freed(name: str) -> None:
    deadline = time.time() + 30
    while time.time() < deadline:
        if herdr("agent", "get", name, check=False).get("error", {}).get("code") == "agent_not_found":
            return
        time.sleep(0.5)
    raise Failed(f"herdr still lists {name} 30 s after its claude exited")


def wait_shell_ready(pane: str) -> None:
    """Returns once the pane's shell runs typed input. In a folder with an .envrc the shell first loads direnv, and
    text typed during that load shows on screen but never runs, so a `claude` typed then is lost and the start times
    out. Each try types a marker command that prints a new number, so an old marker on screen never matches."""
    deadline = time.time() + READY_WAIT_S
    while time.time() < deadline:
        try:
            claude_process(pane)
        except Failed:
            pass
        else:
            raise Failed(f"a claude already runs in pane {pane}")
        n = int.from_bytes(os.urandom(4), "big")
        herdr("pane", "run", pane, f"echo shell-ready-$(({n}+1))")
        if "result" in herdr("pane", "wait-output", pane, "--match", f"shell-ready-{n + 1}", "--timeout", "3000",
                             check=False):
            return
    raise Failed(f"the shell in pane {pane} ran no typed command in {READY_WAIT_S} s")


def start_claude(pane: str, name: str, config_dir: str, args: list[str]) -> None:
    wait_shell_ready(pane)
    env = "export CLAUDE_ACCOUNTS_PLAIN=1; " + (
        f"export CLAUDE_CONFIG_DIR={shlex.quote(config_dir)}" if config_dir else "unset CLAUDE_CONFIG_DIR"
    )
    herdr("pane", "run", pane, env)
    deadline = time.time() + 60
    while True:
        try:
            herdr("agent", "start", name, "--kind", "claude", "--pane", pane, "--timeout", "120000", "--", *args)
            return
        except Failed as e:
            code = error_code(e)
            if code == "agent_pane_busy" and time.time() < deadline:
                time.sleep(1)
                continue
            if code != "agent_not_ready":
                raise
        if "Yes, I trust this folder" not in screen_of(name):
            raise Failed(f"{name} is blocked at startup by something other than the folder trust question")
        herdr("agent", "send-keys", name, "down")
        herdr("agent", "send-keys", name, "enter")
        herdr("agent", "wait", name, "--until", "idle", "--timeout", "60000")
        return


def read_usage(names: list[str]) -> dict[str, dict | None]:
    """Each account's meters, checked now: session and week in percent and their reset times in unix seconds. An
    account that is logged out or could not be read has None."""
    if not names:
        return {}  # without --account, claude-usage would check every account
    args = [x for n in names for x in ("--account", n)]
    try:
        subprocess.run([str(USAGE), "--quiet", *args], timeout=300, check=False, stdin=subprocess.DEVNULL)
        entries = cu.entries_of(json.loads(cu.CACHE.read_text()))
    except (OSError, json.JSONDecodeError, subprocess.TimeoutExpired) as e:
        log(f"claude-usage failed: {e}")
        return dict.fromkeys(names)
    out: dict[str, dict | None] = {}
    for n in names:
        e = entries.get(n) or {}
        five, week = e.get("five_hour"), e.get("seven_day")
        if e.get("state") not in ("ok", "expiring") or not five:
            log(f"usage of {n}: {e.get('state', 'no entry')}{': ' + e['error'] if e.get('error') else ''}")
            out[n] = None
            continue
        out[n] = {"session": round(five["used"]), "session_reset": five.get("resets_at"),
                  "week": round(week["used"]) if week else None, "week_reset": week.get("resets_at") if week else None}
    return out


def load(name: str) -> dict:
    try:
        return json.loads((STATE / name).read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save(name: str, data: dict) -> None:
    (STATE / name).write_text(json.dumps(data, indent=1) + "\n")


def log(msg: str) -> None:
    line = f"{datetime.now().astimezone().isoformat(timespec='seconds')} {msg}"
    print(line, flush=True)
    events = STATE / "events.log"
    if events.exists() and events.stat().st_size >= EVENTS_MAX:
        events.replace(STATE / "events.log.1")
    with events.open("a") as f:
        f.write(line + "\n")


def at(t: float | None) -> str:
    return datetime.fromtimestamp(t).astimezone().strftime("%a %H:%M") if t else "unknown"


def switch(name: str, to: str | None, stay: bool = False) -> bool:
    """Moves the agent to account `to`, else to claude-usage's next account. With stay, as after a limit, that may be
    the agent's own account once its limit has reset, and then the agent only gets the resume message."""
    chosen = to is None
    agent = herdr("agent", "get", name)["result"]["agent"]
    if agent.get("agent") != "claude" or agent.get("agent_status") == "working":
        what = f"{agent['agent']} and {agent.get('agent_status')}" if agent.get("agent") else "no running agent"
        raise Failed(f"{name} is {what}; only an idle Claude agent can move")
    session = (agent.get("agent_session") or {}).get("value")
    if not session:
        raise Failed(f"herdr knows no session id for {name}; is the claude integration installed?")
    pane = agent["pane_id"]
    pid, argv, config_dir = claude_process(pane)
    dirs = cu.accounts()
    current = account_of(config_dir, dirs)
    if to is None:
        to = cu.next_account(None if stay else current)
        if to is None:
            log(f"{name}: every other account is limited or unreadable; {name} stays on {current}")
            return False
    elif to not in dirs:
        raise Failed(f"unknown account {to}")
    msg_file = RESUME / name
    if chosen and to == current:
        herdr("agent", "prompt", name, msg_file.read_text().strip() if msg_file.is_file() else (
            f"The usage limit of your Claude account {current} has reset. Continue where you stopped."
        ))
        log(f"{name}: the limit of {current} has reset; told it to continue, session {session}")
        return True
    exit_claude(name, pid)
    try:
        start_claude(pane, name, dirs[to], resume_args(argv[1:], session))
    except Failed as e:
        log(f"{name}: start on {to} failed ({e}); starting it on {current} again")
        start_claude(pane, name, dirs[current], resume_args(argv[1:], session))
        raise
    msg = msg_file.read_text().strip() if msg_file.is_file() else (
        f"Your Claude account {current} hit its usage limit, so this session now runs on the {to} account. "
        "Continue where you stopped."
    )
    herdr("agent", "prompt", name, msg)
    log(f"{name}: moved from {current} to {to}, session {session}")
    return True


def live_names() -> set[str]:
    return {a.get("name") for a in herdr("agent", "list")["result"]["agents"]}


def start_recorded(name: str, r: dict, why: str) -> str:
    """Start a recorded agent like `clauded --resume <session>` on its account, in its old pane when that pane is
    free, else in a new workspace; returns the pane."""
    panes = {x["pane_id"]: x for x in herdr("pane", "list")["result"]["panes"]}
    pane, workspace = r["pane"], None
    if pane not in panes or panes[pane].get("agent"):
        ws = herdr("workspace", "create", "--cwd", r["cwd"], "--label", r["workspace"] or name, "--no-focus")
        pane, workspace = ws["result"]["root_pane"]["pane_id"], ws["result"]["workspace"]["workspace_id"]
    try:
        start_claude(pane, name, r["config_dir"], resume_args(r["args"], r["session"]))
    except Failed:
        if workspace:
            try:
                herdr("workspace", "close", workspace)
            except Failed as e:
                log(f"{name}: could not close workspace {workspace} after the failed start: {e}")
        raise
    msg_file = RESUME / name
    msg = msg_file.read_text().strip() if msg_file.is_file() else (
        f"{why}, and this session was resumed with clauded --resume on the same account. Continue where you stopped."
    )
    herdr("agent", "prompt", name, msg)
    return pane


def restore(record: dict, server: str, wait: bool = True) -> list[str]:
    """Start the recorded agents that a server restart lost; returns the names that failed. With wait, as in
    scan, a name whose start failed less than COOLDOWN ago is not tried again yet and counts as failed."""
    failed, tried = [], load("restore-failed.json")
    for n in to_restore(record, live_names(), server):
        r = record["agents"][n]
        if wait and tried.get(n, 0) > time.time() - COOLDOWN:
            failed.append(n)
            continue
        try:
            pane = start_recorded(n, r, "The herdr server restarted")
            tried.pop(n, None)
            log(f"{n}: restored in pane {pane} after a herdr server restart, session {r['session']}")
        except Failed as e:
            failed.append(n)
            tried[n] = time.time()
            log(f"{n}: restore failed, next try in {COOLDOWN // 60} min: {e}")
    save("restore-failed.json", tried)
    return failed


def resume(record: dict, name: str) -> None:
    if name in live_names():
        try:
            claude_process(herdr("agent", "get", name)["result"]["agent"]["pane_id"])
            log(f"{name} is running already; `herdr agent get {name}` shows its pane")
            return
        except Failed:
            wait_freed(name)
    r = recorded(record, name)
    pane = start_recorded(name, r, "This agent had exited")
    log(f"{name}: resumed in pane {pane} by hand, session {r['session']}")


def snapshot(server: str, record: dict, failed: list[str]) -> None:
    labels = {w["workspace_id"]: w.get("label") for w in herdr("workspace", "list")["result"]["workspaces"]}
    agents = {}
    for a in herdr("agent", "list")["result"]["agents"]:
        name, sid = a.get("name"), (a.get("agent_session") or {}).get("value")
        if a.get("agent") not in ("claude", None) or name is None or not sid:
            continue
        try:
            _, argv, config_dir = claude_process(a["pane_id"])
        except Failed:
            continue
        agents[name] = {"pane": a["pane_id"], "workspace": labels.get(a["workspace_id"]), "cwd": a["cwd"],
                        "session": sid, "config_dir": config_dir, "args": argv[1:]}
    save("agents.json", next_record(record, agents, server, failed, time.time()))


@contextmanager
def locked():
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "lock").open("w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def scan() -> int:
    server = ensure_server()
    record = load("agents.json")
    lost = restore(record, server)
    switched = load("switched.json")
    dirs, failed = None, len(lost)
    for a in herdr("agent", "list")["result"]["agents"]:
        name = a.get("name")
        if a.get("agent") != "claude" or a.get("agent_status") == "working" or name is None:
            continue
        if switched.get(name, 0) > time.time() - COOLDOWN:
            continue
        hit = find_limit(screen_of(name))
        if not hit:
            continue
        try:
            dirs = dirs or cu.accounts()
            current = account_of(claude_process(a["pane_id"])[2], dirs)
            held = cu.hold_limit(current, hit)
            what = f"held until {at(held[0])} after a {held[1]}" if held else "not held, its limit has reset"
            log(f"{name}: {current} shows {hit!r}; {what}")
            switch(name, None, stay=True)
        except (Failed, OSError, subprocess.SubprocessError, ValueError) as e:
            failed += 1
            log(f"{name}: switch failed: {e!r}")
        switched[name] = time.time()
        save("switched.json", switched)
    snapshot(server, record, lost)
    return 1 if failed else 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Move herdr Claude agents off accounts that hit a usage limit.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("scan")
    sub.add_parser("restore")
    sw = sub.add_parser("switch")
    sw.add_argument("name")
    sw.add_argument("--to")
    sub.add_parser("resume").add_argument("name")
    us = sub.add_parser("usage")
    us.add_argument("accounts", nargs="*")
    a = ap.parse_args()
    with locked():
        try:
            if a.cmd == "scan":
                return scan()
            if a.cmd in ("restore", "resume"):
                # resume restores first: after a server restart the other missing agents need the restore, and the
                # snapshot below would otherwise record them as ended.
                server = ensure_server()
                record = load("agents.json")
                lost = restore(record, server, wait=False)
                try:
                    if a.cmd == "resume" and a.name not in lost:
                        resume(record, a.name)
                finally:
                    snapshot(server, record, lost)
                return 1 if lost else 0
            if a.cmd == "switch":
                ok = switch(a.name, a.to)
                if ok:
                    switched = load("switched.json")
                    switched[a.name] = time.time()
                    save("switched.json", switched)
                return 0 if ok else 1
            usage = read_usage(a.accounts or list(cu.accounts()))
            for n, u in usage.items():
                print(f"{n:12} " + (f"session {u['session']}% (resets {at(u['session_reset'])})  week {u['week']}% "
                                    f"(resets {at(u['week_reset'])})" if u else "no reading"))
            return 0
        except Failed as e:
            log(f"{a.cmd} failed: {e}")
            return 1


if __name__ == "__main__":
    sys.exit(main())
