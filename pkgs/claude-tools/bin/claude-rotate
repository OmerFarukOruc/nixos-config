#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

HOME = Path.home()
BIN = Path(__file__).resolve().parent
USAGE = BIN / "claude-usage"
STATE = Path(os.environ.get("CLAUDE_ROTATE_STATE") or HOME / ".local/state/claude-rotate")
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/claude-rotate-{os.getuid()}") / "claude-rotate"
HELP_CACHE = HOME / ".cache/claude-rotate"
CACHE_MAX_AGE = 900
MIN_WAIT = 60
PICKED, CANCELLED, REFRESH = 0, 1, 3
NON_INTERACTIVE = {"-p", "--print", "-v", "--version", "-h", "--help"}
SESSION_FLAGS = {"-r", "--resume", "-c", "--continue", "--session-id", "--fork-session", "--from-pr"}


def load(name: str):
    loader = SourceFileLoader(name.replace("-", "_"), str(BIN / name))
    mod = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


cu = load("claude-usage")


def log(msg: str) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "events.log").open("a") as f:
        f.write(f"{datetime.now().astimezone().isoformat(timespec='seconds')} {msg}\n")


def say(msg: str) -> None:
    print(f"claude-rotate: {msg}", file=sys.stderr, flush=True)
    log(msg)


def claude_help() -> str:
    """`claude --help`, cached per installed binary, because it costs a node start."""
    real = Path(shutil.which("claude") or "claude").resolve()
    key = re.sub(r"[^\w.-]", "_", f"{real}-{int(real.stat().st_mtime)}")
    f = HELP_CACHE / f"help-{key}.txt"
    if not f.exists():
        text = subprocess.run(["claude", "--help"], capture_output=True, text=True, check=False).stdout
        if "Commands:" not in text:
            raise OSError("claude --help printed no command list")
        HELP_CACHE.mkdir(parents=True, exist_ok=True)
        for old in HELP_CACHE.glob("help-*.txt"):
            old.unlink(missing_ok=True)
        tmp = f.with_suffix(f".{os.getpid()}")
        tmp.write_text(text)
        tmp.replace(f)
    return f.read_text()


def parse_help(text: str) -> tuple[dict[str, str], set[str]]:
    """Options with the kind of value they take ("", "required", "optional", "variadic"), and the subcommands."""
    opts, cmds, section = {}, set(), None
    for line in text.splitlines():
        if re.match(r"^\S", line):
            section = line.strip().rstrip(":").lower()
            continue
        # An option line has two spaces before its first flag; wrapped description lines have more.
        if section == "options" and (m := re.match(r"^  ((?:--?[\w-]+, )*--?[\w-]+)(?: ([<\[])[^>\]]*?(\.\.\.)?[>\]])?", line)):
            kind = "" if not m[2] else "variadic" if m[3] else "required" if m[2] == "<" else "optional"
            for o in m[1].split(", "):
                opts[o] = kind
        elif section == "commands" and (m := re.match(r"^  ([a-z][\w|-]*)", line)):
            cmds.update(m[1].split("|"))
    return opts, cmds


def interactive(args: list[str], cmds: set[str]) -> bool:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    if any(a in NON_INTERACTIVE for a in args):
        return False
    return not (args and args[0] in cmds)


def resume_args(args: list[str], opts: dict[str, str], session: str, message: str) -> list[str]:
    """The original flags without the prompt and the session choice, then --resume SESSION MESSAGE."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        if not a.startswith("-"):
            continue
        name = a.split("=", 1)[0]
        kind = "" if "=" in a else opts.get(name, "")
        taken = []
        if kind == "required" and i < len(args):
            taken, i = [args[i]], i + 1
        elif kind in ("optional", "variadic"):
            while i < len(args) and not args[i].startswith("-"):
                taken.append(args[i])
                i += 1
                if kind == "optional":
                    break
        if name not in SESSION_FLAGS:
            out += [a, *taken]
    return [*out, "--resume", session, message]


def when(t: float) -> str:
    return datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds")


def choose(names: list[str], recommend: str | None) -> str | None:
    """Runs the account picker until it ends. Returns the chosen account, "" when the user quit, or None when the
    picker failed, so claude starts on the recommended account."""
    cursor = recommend
    while True:
        cmd = [str(USAGE), "--pick", *(["--cursor", cursor] if cursor else [])]
        try:
            p = subprocess.run(cmd, stdout=subprocess.PIPE, text=True, check=False)
        except OSError as e:
            say(f"could not open the account picker ({e})")
            return None
        if p.returncode == PICKED:
            return p.stdout.strip()
        if p.returncode == CANCELLED:
            return ""
        if p.returncode != REFRESH:
            say(f"the account picker exited {p.returncode}")
            return None
        cursor = p.stdout.strip() or cursor
        print("claude-rotate: checking every account's usage…", file=sys.stderr, flush=True)
        try:
            cu.locked_refresh(names, None)
        except (OSError, subprocess.SubprocessError, ValueError) as e:
            say(f"could not check the accounts' usage ({e})")


def env_for(base: dict, config_dir: str) -> dict:
    env = dict(base)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if config_dir:
        env["CLAUDE_CONFIG_DIR"] = config_dir
    return env


class Runner:
    """Runs one Claude child at a time on the terminal this process owns."""

    def __init__(self) -> None:
        self.child: subprocess.Popen | None = None
        self.quit = False
        for s in (signal.SIGINT, signal.SIGQUIT):
            signal.signal(s, signal.SIG_IGN)
        for s in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(s, self.forward)

    def forward(self, sig: int, _frame: object) -> None:
        self.quit = True
        if self.child and self.child.poll() is None:
            self.child.send_signal(sig)

    def start(self, argv: list[str], env: dict) -> None:
        def restore() -> None:
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.signal(signal.SIGQUIT, signal.SIG_DFL)

        self.child = subprocess.Popen(argv, env=env, preexec_fn=restore)  # noqa: PLW1509 - no threads here

    def wait(self, flag: Path, until: float | None = None) -> int | dict | None:
        """The child's exit code, the hook input when its turn failed on a limit, or None once `until` has passed."""
        pid = self.child.pid
        while True:
            try:
                got, status = os.waitpid(pid, os.WNOHANG | os.WUNTRACED)
            except ChildProcessError:
                code = self.child.returncode or 0
                return code if code >= 0 else 128 - code
            if got == pid:
                if os.WIFSTOPPED(status):
                    os.kill(os.getpid(), signal.SIGSTOP)
                    continue
                code = os.waitstatus_to_exitcode(status)
                self.child.returncode = code
                return code if code >= 0 else 128 - code
            if not self.quit and flag.exists():
                try:
                    data = json.loads(flag.read_text())
                except (OSError, json.JSONDecodeError):
                    data = {}
                flag.unlink(missing_ok=True)
                if data.get("session_id"):
                    return data
            if until is not None and time.time() >= until:
                return None
            time.sleep(0.5)

    def stop(self) -> None:
        self.child.send_signal(signal.SIGTERM)
        try:
            self.child.wait(15)
        except subprocess.TimeoutExpired:
            self.child.kill()
            self.child.wait()
        subprocess.run(["stty", "sane"], check=False, stderr=subprocess.DEVNULL)


@dataclass
class Stop:
    """A session whose turn failed on a usage limit: its transcript and that transcript's size at the limit."""

    session: str
    transcript: Path | None
    seen: int

    @classmethod
    def at_limit(cls, hook: dict) -> Stop:
        transcript = Path(hook["transcript_path"]) if hook.get("transcript_path") else None
        try:
            seen = transcript.stat().st_size if transcript else 0
        except OSError:
            seen = 0
        return cls(hook["session_id"], transcript, seen)

    def continued(self) -> bool:
        """Whether the transcript gained a user line since the limit, so the session went on by hand."""
        if not self.transcript:
            return False
        try:
            with self.transcript.open("rb") as f:
                f.seek(self.seen)
                lines = f.read().splitlines()
        except OSError:
            return False
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if isinstance(entry, dict) and entry.get("type") == "user" and not entry.get("isMeta"):
                return True
        return False


def wake_time(session: str, names: list[str]) -> float:
    """When to pick an account again: once the first account, the session's own included, is free, else after
    NO_RESET_WAIT, and never sooner than MIN_WAIT."""
    at = time.time()
    try:
        free = cu.free_at(names, int(at))
    except Exception as e:  # noqa: BLE001 - a broken cache must not end the session
        log(f"session {session}: reading when an account is free failed: {e!r}")
        free = None
    until = max(free or at + cu.NO_RESET_WAIT, at + MIN_WAIT)
    log(f"session {session}: no account is free; picking again at {when(until)}")
    return until


def after_limit(current: str, hook: dict) -> str | None:
    """Holds current back after the limit the hook input reports and returns the account to resume on, or None."""
    held = cu.hold_limit(current, hook.get("last_assistant_message") or "")
    nxt = cu.next_account(None)
    what = f"a {held[1]} until {when(held[0])}" if held else "a limit that has already reset"
    log(f"{current} hit {what}; next account: {nxt or 'none'}")
    return nxt


def main() -> int:
    args = sys.argv[1:]
    try:
        opts, cmds = parse_help(claude_help())
    except (OSError, subprocess.SubprocessError) as e:
        say(f"could not read claude --help ({e}); running plain claude, without account moves")
        os.execvp("claude", ["claude", *args])
    if not interactive(args, cmds):
        os.execvp("claude", ["claude", *args])

    rotate_id = str(os.getpid())
    base = {**os.environ, "CLAUDE_ROTATE_ID": rotate_id}
    try:
        dirs = cu.accounts()
        names = list(dirs)
        if cu.now() - cu.load_cache().get("updated", 0) > CACHE_MAX_AGE:
            print("claude-rotate: reading account usage…", file=sys.stderr, flush=True)
        current = cu.best(cu.entries_of(cu.locked_refresh([], CACHE_MAX_AGE)), names, cu.now())
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError) as e:
        say(f"could not pick an account ({e}); running plain claude")
        os.execvp("claude", ["claude", *args])
    if os.environ.get("CLAUDE_ACCOUNTS_PICK") != "0":
        chosen = choose(names, current)
        if chosen == "":
            return 0
        current = chosen or current
    if current is None:
        configured = os.environ.get("CLAUDE_CONFIG_DIR", "")
        current = next((n for n, d in dirs.items() if d == configured), names[0] if names else "")
        say(f"every account is limited or unreadable; starting on {current}")
        time.sleep(1)
    RUNTIME.mkdir(parents=True, exist_ok=True)
    runner = Runner()
    argv = ["claude", *args]
    while True:
        runner.start(argv, env_for(base, dirs.get(current, "")))
        flag = RUNTIME / f"{rotate_id}-{runner.child.pid}.json"
        stop: Stop | None = None
        wake: float | None = None
        while True:
            got = runner.wait(flag, wake)
            if isinstance(got, int):
                return got
            if got is not None:
                stop = Stop.at_limit(got)
            try:
                nxt = after_limit(current, got) if got else cu.next_account(None)
            except Exception as e:  # noqa: BLE001 - Claude keeps the terminal, so this process must keep waiting
                log(f"session {stop.session}: no move, picking the next account failed: {e!r}")
                nxt = None
            if runner.child.poll() is not None:
                continue
            if stop.continued():
                log(f"session {stop.session}: a prompt went in after the limit; no move")
                stop = wake = None
                continue
            if nxt and not runner.quit:
                break
            wake = wake_time(stop.session, names)
        session = stop.session
        if nxt == current:
            say(f"the usage limit of {current} has reset; resuming session {session} on it")
            message = (f"The usage limit of your Claude account {current} has reset, so claude-rotate resumed this "
                       "session on it. Continue where you stopped.")
        else:
            say(f"{current} hit its usage limit; resuming session {session} on {nxt}")
            message = (f"Your Claude account {current} hit its usage limit, so claude-rotate resumed this session on "
                       f"the {nxt} account. Continue where you stopped.")
        runner.stop()
        argv = ["claude", *resume_args(args, opts, session, message)]
        args = argv[1:-3]
        current = nxt


if __name__ == "__main__":
    sys.exit(main())
