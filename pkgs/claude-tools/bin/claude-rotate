#!/usr/bin/env python3
# Starts an interactive Claude Code session on the claude-accounts account with the most room, and moves the session
# to the next account when it hits a usage limit. claude-accounts.sh makes `claude` a shell function that
# runs this, unless `claude --account NAME` pins an account, CLAUDE_CONFIG_DIR is set, CLAUDE_ACCOUNTS_PLAIN marks a
# herdr agent that claude-limit-switch moves, or stdin or stdout is no terminal.
#   claude-rotate [CLAUDE ARGS...]
# Any non-interactive call (-p, --version, a subcommand such as `auth`) runs plain claude with nothing changed.
# The pick: the account with the lowest weekly use among those under MAX_USED in both windows, from the claude-usage
# cache, skipping accounts marked limited and accounts without a reading. With no such account, claude starts on the
# account the environment already selects. Before the start, `claude-usage --pick` shows every account with that pick
# under the cursor: enter starts it, another row starts another account, q starts nothing. CLAUDE_ACCOUNTS_PICK=0
# starts on the pick without asking.
# The move: Claude Code fires the StopFailure hook with matcher rate_limit when a turn fails on a limit, and
# The dotfiles checkout's desktop/claude-code/hooks/rotate-on-limit.sh writes the hook input to $XDG_RUNTIME_DIR/claude-rotate/ID-PID.json, where
# ID is CLAUDE_ROTATE_ID from this process and PID is the Claude process the hook belongs to. This process then marks
# the account limited until its window resets, stops Claude with SIGTERM (the transcript stays resumable; checked on
# 19-10-2026 with 2.1.303), and starts `claude --resume SESSION MESSAGE` with the original flags on the next account.
# When no account is free, the session stays where it is until the first other account's recorded limit ends, if that
# comes before its own account's; then this process picks again and moves the session to the account that is free.
# The accounts share ~/.claude/projects, so the session carries over.
# State: ~/.local/state/claude-rotate/limits.json (account: limited until, reason) and events.log.
from __future__ import annotations

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
BIN = Path(__file__).resolve().parent
PROFILES = BIN / "claude-accounts"
USAGE = BIN / "claude-usage"
CACHE = Path(os.environ.get("CLAUDE_USAGE_CACHE") or HOME / ".cache/claude-usage/usage.json")
STATE = Path(os.environ.get("CLAUDE_ROTATE_STATE") or HOME / ".local/state/claude-rotate")
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/claude-rotate-{os.getuid()}") / "claude-rotate"
HELP_CACHE = HOME / ".cache/claude-rotate"
# claude-limit-switch's SESSION_MAX, here for both windows; a guess, so a moved session gets some turns before the
# next move.
MAX_USED = 90
# Chosen: a cache older than this is refreshed before the pick; claude-usage.timer runs every 10 min.
CACHE_MAX_AGE = 900
# An account whose limit names no reset time, such as a model limit, is skipped for this long (claude-limit-switch).
NO_RESET_WAIT = 3600
# The exit codes of claude-usage --pick (claude-usage Picker).
PICKED, CANCELLED, REFRESH = 0, 1, 3
NON_INTERACTIVE = {"-p", "--print", "-v", "--version", "-h", "--help"}
# Dropped on resume: they pick or fork the session, which --resume SESSION replaces.
SESSION_FLAGS = {"-r", "--resume", "-c", "--continue", "--session-id", "--fork-session", "--from-pr"}


def log(msg: str) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "events.log").open("a") as f:
        f.write(f"{datetime.now().astimezone().isoformat(timespec='seconds')} {msg}\n")


def say(msg: str) -> None:
    print(f"claude-rotate: {msg}", file=sys.stderr, flush=True)
    log(msg)


def claude_help() -> str:
    """`claude --help`, cached per installed binary, because it costs a node start."""
    real = Path(shutil.which("claude") or "claude").resolve()
    key = re.sub(r"[^\w.-]", "_", f"{real}-{int(real.stat().st_mtime)}")
    f = HELP_CACHE / f"help-{key}.txt"
    if not f.exists():
        text = subprocess.run(["claude", "--help"], capture_output=True, text=True, check=False).stdout
        if "Commands:" not in text:
            raise OSError("claude --help printed no command list")
        HELP_CACHE.mkdir(parents=True, exist_ok=True)
        for old in HELP_CACHE.glob("help-*.txt"):
            old.unlink(missing_ok=True)
        tmp = f.with_suffix(f".{os.getpid()}")
        tmp.write_text(text)
        tmp.replace(f)
    return f.read_text()


def parse_help(text: str) -> tuple[dict[str, str], set[str]]:
    """Options with the kind of value they take ("", "required", "optional", "variadic"), and the subcommands."""
    opts, cmds, section = {}, set(), None
    for line in text.splitlines():
        if re.match(r"^\S", line):
            section = line.strip().rstrip(":").lower()
            continue
        # An option line has two spaces before its first flag; wrapped description lines have more.
        if section == "options" and (m := re.match(r"^  ((?:--?[\w-]+, )*--?[\w-]+)(?: ([<\[])[^>\]]*?(\.\.\.)?[>\]])?", line)):
            kind = "" if not m[2] else "variadic" if m[3] else "required" if m[2] == "<" else "optional"
            for o in m[1].split(", "):
                opts[o] = kind
        elif section == "commands" and (m := re.match(r"^  ([a-z][\w|-]*)", line)):
            cmds.update(m[1].split("|"))
    return opts, cmds


def interactive(args: list[str], cmds: set[str]) -> bool:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    if any(a in NON_INTERACTIVE for a in args):
        return False
    return not (args and args[0] in cmds)


def resume_args(args: list[str], opts: dict[str, str], session: str, message: str) -> list[str]:
    """The original flags without the prompt and the session choice, then --resume SESSION MESSAGE."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        if not a.startswith("-"):
            continue  # the first prompt; the session already holds it
        name = a.split("=", 1)[0]
        kind = "" if "=" in a else opts.get(name, "")
        taken = []
        if kind == "required" and i < len(args):
            taken, i = [args[i]], i + 1
        elif kind in ("optional", "variadic"):
            while i < len(args) and not args[i].startswith("-"):
                taken.append(args[i])
                i += 1
                if kind == "optional":
                    break
        if name not in SESSION_FLAGS:
            out += [a, *taken]
    return [*out, "--resume", session, message]


def accounts() -> dict[str, str]:
    def run(*a: str) -> str:
        return subprocess.run([str(PROFILES), *a], capture_output=True, text=True, check=True).stdout.strip()

    return {n: run("dir", n) for n in run("names").split()}


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_limits(limits: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / f"limits.json.{os.getpid()}"
    tmp.write_text(json.dumps(limits, indent=1) + "\n")
    tmp.replace(STATE / "limits.json")


def usage(refresh: list[str] | None = None) -> dict[str, dict]:
    """Account name to its claude-usage entry. With refresh, those accounts are checked now."""
    cmd = [str(USAGE), "--quiet", *([x for n in refresh for x in ("--account", n)] if refresh else
                                    ["--max-age", str(CACHE_MAX_AGE)])]
    if not refresh and time.time() - load_json(CACHE).get("updated", 0) > CACHE_MAX_AGE:
        print("claude-rotate: reading account usage…", file=sys.stderr, flush=True)
    try:
        subprocess.run(cmd, timeout=120, check=False, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        log(f"{' '.join(cmd)} took longer than 120 s; using the cache as it is")
    return {a["name"]: a for a in load_json(CACHE).get("accounts", [])}


def pick(names: list[str], skip: str | None, entries: dict[str, dict], limits: dict, now: float) -> str | None:
    best = None
    for n in names:
        e = entries.get(n)
        if (n == skip or limits.get(n, {}).get("until", 0) > now or not e or e["state"] not in ("ok", "expiring")
                or not e.get("five_hour")):
            continue
        # Team plans have no weekly window.
        five, week = e["five_hour"]["used"], (e.get("seven_day") or {}).get("used", 0)
        if five >= MAX_USED or week >= MAX_USED:
            continue
        if best is None or (week, five) < best[0]:
            best = ((week, five), n)
    return best[1] if best else None


def choose(names: list[str], recommend: str | None, limits: dict) -> str | None:
    """Runs the account picker until it ends. Returns the chosen account, "" when the user quit, or None when the
    picker failed, so claude starts on the recommended account."""
    cursor = recommend
    while True:
        held = [n for n in names if limits.get(n, {}).get("until", 0) > time.time()]
        cmd = [str(USAGE), "--pick", *(["--recommend", recommend] if recommend else []),
               *[x for n in held for x in ("--held", n)], *(["--cursor", cursor] if cursor else [])]
        try:
            p = subprocess.run(cmd, stdout=subprocess.PIPE, text=True, check=False)
        except OSError as e:
            say(f"could not open the account picker ({e})")
            return None
        if p.returncode == PICKED:
            return p.stdout.strip()
        if p.returncode == CANCELLED:
            return ""
        if p.returncode != REFRESH:
            say(f"the account picker exited {p.returncode}")
            return None
        cursor = p.stdout.strip() or cursor
        print("claude-rotate: checking every account's usage…", file=sys.stderr, flush=True)
        recommend = pick(names, None, usage(names), limits, time.time())


def limited_until(entry: dict | None, now: float) -> tuple[float, str]:
    for key, label in (("seven_day", "weekly"), ("five_hour", "session")):
        w = (entry or {}).get(key)
        if w and w["used"] >= 100 and w.get("resets_at"):
            return w["resets_at"], f"{label} limit"
    return now + NO_RESET_WAIT, "limit with no full window"


def env_for(base: dict, config_dir: str) -> dict:
    env = dict(base)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if config_dir:
        env["CLAUDE_CONFIG_DIR"] = config_dir
    return env


class Runner:
    """Runs one Claude child at a time on the terminal this process owns."""

    def __init__(self) -> None:
        self.child: subprocess.Popen | None = None
        self.quit = False
        for s in (signal.SIGINT, signal.SIGQUIT):
            signal.signal(s, signal.SIG_IGN)  # Claude reads the keys itself; the terminal's signals reach it directly
        for s in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(s, self.forward)

    def forward(self, sig: int, _frame: object) -> None:
        self.quit = True
        if self.child and self.child.poll() is None:
            self.child.send_signal(sig)

    def start(self, argv: list[str], env: dict) -> None:
        # Claude must not inherit the ignored SIGINT and SIGQUIT.
        def restore() -> None:
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.signal(signal.SIGQUIT, signal.SIG_DFL)

        self.child = subprocess.Popen(argv, env=env, preexec_fn=restore)  # noqa: PLW1509 - no threads here

    def wait(self, flag: Path, until: float | None = None) -> int | dict | None:
        """The child's exit code, the hook input when its turn failed on a limit, or None once `until` has passed."""
        pid = self.child.pid
        while True:
            try:
                got, status = os.waitpid(pid, os.WNOHANG | os.WUNTRACED)
            except ChildProcessError:  # the signal handler's poll() reaped it
                code = self.child.returncode or 0
                return code if code >= 0 else 128 - code
            if got == pid:
                if os.WIFSTOPPED(status):
                    # Claude suspended itself (ctrl+z); stop too, so the shell gets the terminal back, and wake it
                    # with us on `fg`, which sends SIGCONT to the whole job.
                    os.kill(os.getpid(), signal.SIGSTOP)
                    continue
                code = os.waitstatus_to_exitcode(status)
                self.child.returncode = code
                return code if code >= 0 else 128 - code  # a shell's exit status for a signal
            if not self.quit and flag.exists():
                try:
                    data = json.loads(flag.read_text())
                except (OSError, json.JSONDecodeError):
                    data = {}
                flag.unlink(missing_ok=True)
                if data.get("session_id"):
                    return data
            if until is not None and time.time() >= until:
                return None
            time.sleep(0.5)

    def stop(self) -> None:
        self.child.send_signal(signal.SIGTERM)
        try:
            self.child.wait(15)
        except subprocess.TimeoutExpired:
            self.child.kill()
            self.child.wait()
        subprocess.run(["stty", "sane"], check=False, stderr=subprocess.DEVNULL)


def next_account(current: str, names: list[str]) -> str | None:
    """Marks current limited until its window resets and picks the account to move to, or None."""
    now = time.time()
    until, reason = limited_until(usage([current]).get(current), now)
    limits = {n: v for n, v in load_json(STATE / "limits.json").items() if v.get("until", 0) > now}
    limits[current] = {"until": until, "reason": reason}
    save_limits(limits)
    nxt = pick(names, current, usage(), limits, now)
    log(f"{current} hit a {reason}; next account: {nxt or 'none'}")
    return nxt


def next_reset(current: str, names: list[str], now: float) -> float | None:
    """When the first other account's recorded limit ends, if that comes before current's own; None otherwise."""
    limits = load_json(STATE / "limits.json")
    own = limits.get(current, {}).get("until", 0)
    ends = [v["until"] for n, v in limits.items() if n != current and n in names and now < v.get("until", 0) < own]
    return min(ends) if ends else None


def main() -> int:
    args = sys.argv[1:]
    try:
        opts, cmds = parse_help(claude_help())
    except (OSError, subprocess.SubprocessError) as e:
        say(f"could not read claude --help ({e}); running plain claude, without account moves")
        os.execvp("claude", ["claude", *args])
    if not interactive(args, cmds):
        os.execvp("claude", ["claude", *args])

    rotate_id = str(os.getpid())
    base = {**os.environ, "CLAUDE_ROTATE_ID": rotate_id}
    try:
        dirs = accounts()
        names = list(dirs)
        limits = load_json(STATE / "limits.json")
        current = pick(names, None, usage(), limits, time.time())
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError) as e:
        # Claude still starts, on the account the environment selects, without moves.
        say(f"could not pick an account ({e}); running plain claude")
        os.execvp("claude", ["claude", *args])
    if os.environ.get("CLAUDE_ACCOUNTS_PICK") != "0":
        chosen = choose(names, current, limits)
        if chosen == "":
            return 0
        current = chosen or current
    if current is None:
        configured = os.environ.get("CLAUDE_CONFIG_DIR", "")
        current = next((n for n, d in dirs.items() if d == configured), names[0] if names else "")
        say(f"no account is under {MAX_USED}% in both windows; starting on {current}")
        time.sleep(1)
    RUNTIME.mkdir(parents=True, exist_ok=True)
    runner = Runner()
    argv = ["claude", *args]
    while True:
        runner.start(argv, env_for(base, dirs.get(current, "")))
        flag = RUNTIME / f"{rotate_id}-{runner.child.pid}.json"
        waiting: tuple[str, float] | None = None  # a session no account was free for, and when to pick again
        while True:
            got = runner.wait(flag, waiting[1] if waiting else None)
            if isinstance(got, int):
                return got
            try:
                if got is None:  # another account's limit has ended
                    session = waiting[0]
                    now = time.time()
                    limits = {n: v for n, v in load_json(STATE / "limits.json").items() if v.get("until", 0) > now}
                    nxt = pick(names, current, usage(names), limits, now)
                    log(f"session {session}: an account's limit ended; next account: {nxt or 'none'}")
                else:
                    session = got["session_id"]
                    nxt = next_account(current, names)
            except Exception as e:  # noqa: BLE001 - Claude keeps the terminal, so this process must keep waiting
                log(f"session {session}: no move, picking the next account failed: {e!r}")
                nxt = None
            # A SIGTERM or SIGHUP during the pick ends Claude; that ends this process too, without a move.
            if nxt and not runner.quit:
                break
            # The session stays on its account, and Claude shows the limit; a later limit event tries again, and so
            # does the end of another account's limit when it comes first.
            try:
                wake = next_reset(current, names, time.time())
            except Exception as e:  # noqa: BLE001 - a broken limits.json must not end the session
                log(f"session {session}: no wait for another account, reading limits.json failed: {e!r}")
                wake = None
            waiting = (session, wake) if wake else None
            if wake:
                log(f"session {session}: no account is free; picking again at "
                    f"{datetime.fromtimestamp(wake).astimezone().isoformat(timespec='seconds')}")
        say(f"{current} hit its usage limit; resuming session {session} on {nxt}")
        runner.stop()
        message = (f"Your Claude account {current} hit its usage limit, so claude-rotate resumed this session on the "
                   f"{nxt} account. Continue where you stopped.")
        argv = ["claude", *resume_args(args, opts, session, message)]
        args = argv[1:-3]  # the flags without the prompt, for the next move
        current = nxt


if __name__ == "__main__":
    sys.exit(main())
