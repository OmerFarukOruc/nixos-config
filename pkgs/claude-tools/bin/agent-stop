#!/usr/bin/env python3
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path


def load(name: str):
    loader = SourceFileLoader(name.replace("-", "_"), str(Path(__file__).resolve().with_name(name)))
    mod = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


cls = load("claude-limit-switch")


def codex_process(pane: str) -> int:
    sock = cls.socket_path()
    for p in Path("/proc").iterdir():
        try:
            if not p.name.isdigit() or (p / "comm").read_text().strip() not in ("codex", ".codex-wrapped"):
                continue
            env = dict(x.split("=", 1) for x in (p / "environ").read_bytes().decode().split("\0") if "=" in x)
            if env.get("HERDR_PANE_ID") == pane and env.get("HERDR_SOCKET_PATH") == sock:
                return int(p.name)
        except OSError:
            continue
    raise cls.Failed(f"no claude or codex process in pane {pane}")


def exit_codex(name: str, pid: int) -> None:
    for _ in range(3):
        cls.herdr("agent", "send-keys", name, "ctrl+c", check=False)
        if cls.gone(pid, 3):
            cls.wait_freed(name)
            return
    raise cls.Failed(f"codex pid {pid} of {name} did not exit")


def is_ours(name: str, tab: dict) -> bool:
    return tab.get("label") == name and tab.get("pane_count") == 1


def close_own_tab(name: str, tab_id: str) -> bool:
    tab = cls.herdr("tab", "get", tab_id, check=False).get("result", {}).get("tab", {})
    if is_ours(name, tab):
        cls.herdr("tab", "close", tab_id)
        return True
    return False


def stop(name: str) -> None:
    data = cls.herdr("agent", "get", name, check=False)
    if "result" not in data:
        code = (data.get("error") or {}).get("code", "no answer")
        tabs = cls.herdr("tab", "list", check=False).get("result", {}).get("tabs", []) if code == "agent_not_found" else []
        own = [t["tab_id"] for t in tabs if is_ours(name, t)]
        if not own:
            raise cls.Failed(f"herdr agent get: {code}")
        for tab_id in own:
            cls.herdr("tab", "close", tab_id)
        print(f"agent-stop: herdr no longer lists {name}; closed its tab {', '.join(own)}")
        return
    agent = data["result"]["agent"]
    try:
        cls.exit_claude(name, cls.claude_process(agent["pane_id"])[0])
    except cls.Failed as e:
        if not str(e).startswith("no claude process"):
            raise
        try:
            pid = codex_process(agent["pane_id"])
        except cls.Failed as e2:
            raise cls.Failed(f"{e2}, but herdr still lists {name}; the tab stays") from e2
        exit_codex(name, pid)
    close_own_tab(name, agent["tab_id"])


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: agent-stop NAME", file=sys.stderr)
        return 2
    try:
        stop(argv[0])
    except cls.Failed as e:
        print(f"agent-stop: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
