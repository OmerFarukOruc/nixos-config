#!/usr/bin/env python3
# Wakes the orchestrator: prints one line for each event in a herdr session, so a Monitor on it delivers them.
#   orch-watch [NAME-REGEX]    NAME-REGEX must match a whole agent name; the default is the list of agents
#                              below, so reviewer subagents do not wake the orchestrator
# Lines, each starting with the UTC time:
#   NAME working -> idle | STATUS: ...   a watched agent finished a turn, with its last STATUS: or NEED: line from
#                                        the screen, else from the session transcript
#   NAME HELD PROMPT / ALERT             a watched agent is blocked on a prompt, turned unknown, or left the list
#   NAME NEED (reply required) | text    a notice from orch-notify (also DONE and INFO), for any agent
#   ALERT host ...                       load, swap or /tmp inodes crossed their limit; "recovered" when they fall back
# The first poll only records state, so a restart prints nothing for agents that were already idle. Notices that
# arrived while no watcher ran print at start: the byte offset read so far is kept in $ORCH_INBOX.offset.
#   ALERT watcher STEP failing (...)     a poll step (inbox, host meters, agents) raised; the loop goes on, and the
#                                        line repeats only when the error changes
# One watcher runs for each inbox, so each notice wakes the orchestrator once: a new watcher stops the older one
# (its pid is in $ORCH_INBOX.watcher) and prints "watcher replaced pid N", and the older one prints "watcher stopped
# by SIGTERM" as its last line. Re-arming a Monitor is therefore safe.
# CLAUDE_LIMIT_SWITCH_SESSION names another herdr session than the default one.
import fcntl
import os
import re
import signal
import subprocess
import sys
import time
from collections.abc import Callable
from datetime import UTC, datetime
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path


def load(name: str):
    loader = SourceFileLoader(name.replace("-", "_"), str(Path(__file__).resolve().with_name(name)))
    mod = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


peek = load("agent-peek")
notify = load("orch-notify")
cls = peek.cls

DEFAULT_NAMES = r"coolify-naming|infra-docs|scraper-ci|env-improve|followups-fix|rebase-two|gd-.*|gastro-thermo"
POLL = 5
LOAD_PER_CORE = 2
SWAP_MAX = 80
INODES_MAX = 70
METERS = {"load": "load1", "swap": "swap used %", "inodes": "/tmp inodes used %"}


def say(msg: str) -> None:
    print(f"{datetime.now(UTC).strftime('%H:%M:%S')} {msg}", flush=True)


def guarded(key: str, step: Callable[[], None], failing: dict[str, str]) -> None:
    """Runs one poll step. A failure prints one ALERT line, and the same error again prints nothing until the step
    has worked once, so the watcher keeps looping and the orchestrator hears that it is partly blind."""
    try:
        step()
    except BrokenPipeError:
        raise
    except (OSError, cls.Failed, subprocess.TimeoutExpired) as e:
        msg = f"{type(e).__name__}: {e}"
        if failing.get(key) != msg:
            failing[key] = msg
            say(f"ALERT watcher {key} failing ({msg})")
    else:
        if failing.pop(key, None):
            say(f"watcher {key} recovered")


class Inbox:
    """Reads the records after the saved offset. The offset file survives a restart; once a poll has read it, the
    in-memory offset is the one that counts, so a disk that cannot take the file does not replay a record each poll."""

    def __init__(self, path: Path):
        self.path = path
        self.offset_file = path.with_name(path.name + ".offset")
        self.offset: int | None = None
        self.saved = 0

    def load(self) -> int:
        try:
            return int(self.offset_file.read_text())
        except (OSError, ValueError):
            return 0

    def save(self) -> None:
        if self.offset == self.saved:
            return
        tmp = self.offset_file.with_name(self.offset_file.name + ".tmp")
        tmp.write_text(str(self.offset))
        os.replace(tmp, self.offset_file)
        self.saved = self.offset

    def poll(self, emit: Callable[[str], None]) -> None:
        """Calls emit for each complete record and saves the offset after each one, so a failure while printing
        loses at most that record's place, never a later record. A failed save is retried on the next poll."""
        if self.offset is None:
            self.offset = self.saved = self.load()
        try:
            size = self.path.stat().st_size
        except FileNotFoundError:
            return
        self.offset = 0 if size < self.offset else self.offset
        with self.path.open("rb") as f:
            f.seek(self.offset)
            data = f.read()
        for raw in data[: data.rfind(b"\n") + 1].splitlines(keepends=True):
            emit(raw.decode(errors="replace").rstrip("\n"))
            self.offset += len(raw)
            self.save()
        self.save()


def take_over(lock_path: Path, wait: float = 10.0):
    """Holds the inbox's watcher lock for the life of this process, after stopping the older watcher that held it.
    Returns the open lock file, which must stay referenced, and the pid it replaced, or None."""
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock = lock_path.open("a+")
    replaced = None
    deadline = time.monotonic() + wait
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            pass
        lock.seek(0)
        text = lock.read().strip()
        if text.isdigit() and replaced != int(text):
            pid = int(text)
            try:
                argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            except OSError:
                argv = []
            if argv and argv[0]:
                if not any(Path(a.decode(errors="replace")).name == "orch-watch" for a in argv[:2]):
                    raise SystemExit(f"orch-watch: {lock_path} is held by pid {pid}, which is not orch-watch; not starting")
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                replaced = pid
        if time.monotonic() > deadline:
            raise SystemExit(f"orch-watch: the watcher holding {lock_path} did not stop within {wait:.0f} s")
        time.sleep(0.2)
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()
    return lock, replaced


def format_record(line: str) -> str:
    fields = line.split("\t")
    if len(fields) != 4:
        return f"--:--:-- ? INFO | {line}"
    when, agent, kind, text = fields
    stamp = when[11:19] if re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", when) else "--:--:--"
    return f"{stamp} {agent} {kind}{' (reply required)' if kind == 'NEED' else ''} | {text}"


def swap_percent(meminfo: str) -> float | None:
    kb = {k: int(v) for k, v in re.findall(r"^(SwapTotal|SwapFree):\s+(\d+) kB$", meminfo, re.MULTILINE)}
    return 100 * (kb["SwapTotal"] - kb["SwapFree"]) / kb["SwapTotal"] if kb.get("SwapTotal") else None


def meters() -> dict[str, tuple[float, float] | None]:
    swap = swap_percent(Path("/proc/meminfo").read_text())
    fs = os.statvfs("/tmp")
    inodes = 100 * (fs.f_files - fs.f_ffree) / fs.f_files if fs.f_files else None
    return {
        "load": (os.getloadavg()[0], LOAD_PER_CORE * (os.cpu_count() or 1)),
        "swap": None if swap is None else (swap, SWAP_MAX),
        "inodes": None if inodes is None else (inodes, INODES_MAX),
    }


def edges(state: dict[str, bool], now: dict[str, tuple[float, float] | None]) -> list[str]:
    """One line when a meter crosses its limit and one when it falls back; `state` holds who is over now."""
    lines = []
    for key, reading in now.items():
        if reading is None:
            continue
        value, limit = reading
        over = value > limit
        if over != state.get(key, False):
            lines.append(f"ALERT host {METERS[key]} {value:.1f}, limit {limit:g}" if over
                         else f"host {METERS[key]} recovered ({value:.1f}, limit {limit:g})")
        state[key] = over
    return lines


def watched(agents: dict[str, str], names: re.Pattern) -> dict[str, str]:
    return {n: s for n, s in agents.items() if names.fullmatch(n)}


def events(prev: dict[str, str], now: dict[str, str], first: bool) -> list[tuple[str, str, str]]:
    """What changed since the last poll, as (agent, kind, detail); updates prev. The first poll only records."""
    out = []
    for name, st in now.items():
        was = prev.get(name)
        if not first and was == "working" and st != "working":
            out.append((name, st if st in ("unknown", "blocked") else "finished", f"{was} -> {st}"))
        prev[name] = st
    for name in [n for n in prev if n not in now]:
        out.append((name, "left", prev.pop(name)))
    return out


def finished_status(screen: str, from_transcript: Callable[[], str | None]) -> str:
    return (peek.status_line(screen) or from_transcript() or "STATUS: (none found)")[:240]


def held_prompt(screen: str) -> str:
    lines = [ln for ln in screen.splitlines() if ln.strip()]
    for i, ln in enumerate(lines):
        if "Do you want to proceed" in ln:
            return lines[max(0, i - 3)].lstrip(" \t│")[:200]
    return "see screen"


def describe(name: str, kind: str, detail: str, entry: dict) -> str:
    if kind == "unknown":
        return f"{name} ALERT state unknown (process may have exited; check pane and transcript)"
    if kind == "blocked":
        return f"{name} HELD PROMPT (herdr blocked): {held_prompt(cls.screen_of(name))}"
    if kind == "left":
        return f"{name} ALERT left herdr agent list (was {detail}); expected only after an orchestrator /exit"
    screen = cls.screen_of(name, "recent-unwrapped", 40)
    return f"{name} {detail} | {finished_status(screen, lambda: peek_status(entry))}"


def describe_or_note(name: str, kind: str, detail: str, entry: dict) -> str:
    """describe(), but an event whose screen or transcript cannot be read is still reported."""
    try:
        return describe(name, kind, detail, entry)
    except (OSError, cls.Failed, subprocess.TimeoutExpired) as e:
        return f"{name} {detail} | (details unavailable: {type(e).__name__}: {e})"


def peek_status(entry: dict) -> str | None:
    answer = peek.answer_of(entry)
    return peek.status_line(answer) if answer else None


def agent_list() -> list[dict]:
    agents = cls.herdr("agent", "list").get("result", {}).get("agents")
    if agents is None:
        raise cls.Failed("herdr agent list: no agents in the answer")
    return agents


def main(argv: list[str]) -> int:
    if argv in (["-h"], ["--help"]):
        header = []
        for line in Path(__file__).read_text().splitlines()[1:]:
            if not line.startswith("#"):
                break
            header.append(line[2:])
        print("\n".join(header))
        return 0
    # A word that starts with "-" is an option, never a name pattern: taken as one, the watcher would start, print
    # the unread notices, and move the shared offset, so the orchestrator's own watcher would lose them.
    if len(argv) > 1 or (argv and argv[0].startswith("-")):
        print("usage: orch-watch [NAME-REGEX]", file=sys.stderr)
        return 2
    names = re.compile(argv[0] if argv else DEFAULT_NAMES)
    inbox = Inbox(notify.inbox_path())
    _lock, replaced = take_over(inbox.path.with_name(inbox.path.name + ".watcher"))

    def stopped(*_):
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        say("watcher stopped by SIGTERM, perhaps replaced by a newer one")
        sys.exit(0)

    signal.signal(signal.SIGTERM, stopped)
    if replaced:
        say(f"watcher replaced pid {replaced}")
    prev: dict[str, str] = {}
    over: dict[str, bool] = {}
    failing: dict[str, str] = {}
    first = True

    def poll_agents() -> None:
        nonlocal first
        entries = {a["name"]: a for a in agent_list() if a.get("name")}
        for name, kind, detail in events(prev, watched({n: a.get("agent_status") for n, a in entries.items()}, names), first):
            say(describe_or_note(name, kind, detail, entries.get(name, {})))
        first = False

    while True:
        guarded("inbox", lambda: inbox.poll(lambda line: print(format_record(line), flush=True)), failing)
        guarded("host meters", lambda: [say(line) for line in edges(over, meters())], failing)
        guarded("agents", poll_agents, failing)
        time.sleep(POLL)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
