#!/usr/bin/env bash
# The BROWSER that `claude-accounts login` gives `claude auth login`, which calls it with the authorize URL.
#   CLAUDE_LOGIN_URL_FILE=F  write the URL to F and open nothing (a login on a headless host, `login NAME --on HOST`)
#   CLAUDE_LOGIN_BRAVE_PROFILE=NAME  open the URL in the Brave profile whose display name is NAME, so the claude.ai
#                            session of that profile signs in; unset or empty opens Brave's last profile
# A NAME this device has no profile for gets a new one in the folder "Claude <name as a slug>". Its Preferences file
# names it before Brave first opens it, and Brave takes that name into its profile list (checked on 19-10-2026 with
# brave-origin and a scratch --user-data-dir). An existing folder is never written.
# Brave is brave-origin (Brave-Origin profiles) on nixos-desktop and nixos-rog. Each device resolves
# the display name to its own profile folder through the browser's Local State file.
set -euo pipefail
url="${1:?usage: claude-login-browser URL}"

if [[ -n "${CLAUDE_LOGIN_URL_FILE:-}" ]]; then
  printf '%s\n' "$url" > "$CLAUDE_LOGIN_URL_FILE"
  exit 0
fi

bin="" state=""
for pair in "brave-origin:Brave-Origin" "brave-browser:Brave-Browser" "brave:Brave-Browser"; do
  if command -v "${pair%%:*}" >/dev/null; then
    bin="${pair%%:*}" state="$HOME/.config/BraveSoftware/${pair#*:}/Local State"
    break
  fi
done
if [[ -z "$bin" ]]; then
  echo "claude-login-browser: no Brave on this host; open this URL yourself: $url" >&2
  exit 1
fi

args=()
want="${CLAUDE_LOGIN_BRAVE_PROFILE:-}"
if [[ -n "$want" ]]; then
  dir=$(jq -r --arg n "$want" '.profile.info_cache // {} | to_entries[] | select(.value.name == $n) | .key' "$state" 2>/dev/null | head -1) || dir=""
  if [[ -z "$dir" ]]; then
    slug=$(tr '[:upper:]' '[:lower:]' <<<"$want" | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//')
    dir="Claude $slug"
    data="$(dirname "$state")"
    if [[ ! -e "$data/$dir" ]]; then
      mkdir -p "$data/$dir"
      jq -n --arg n "$want" '{profile: {name: $n}}' > "$data/$dir/Preferences"
      echo "claude-login-browser: created the Brave profile \"$want\" in $data/$dir" >&2
    fi
  fi
  args=(--profile-directory="$dir")
fi
setsid -f "$bin" "${args[@]}" "$url" >/dev/null 2>&1 </dev/null
