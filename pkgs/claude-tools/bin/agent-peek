#!/usr/bin/env python3
# Shows where a herdr agent stands without opening its pane: `agent-peek NAME [LINES]`.
# It prints the agent's state, its last STATUS: or NEED: line, and the last LINES (default 20) lines of its last
# answer, read from the session transcript because the screen can miss an answer on Claude's alternate screen
# (the dotfiles checkout's desktop/reference/headless-clis/herdr.md). Without a transcript it prints the visible screen instead.
# CLAUDE_LIMIT_SWITCH_SESSION names another herdr session than the default one.
import json
import re
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path


def load(name: str):
    loader = SourceFileLoader(name.replace("-", "_"), str(Path(__file__).resolve().with_name(name)))
    mod = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


cls = load("claude-limit-switch")

TAIL_BYTES = 4 << 20
STATUS = re.compile(r"^\s*(?:● )?((?:STATUS|NEED):.*)$")


def mtime(path: Path) -> float:
    try:
        return path.stat().st_mtime
    except OSError:
        return -1.0


def transcript_path(session: str, home: Path | None = None) -> Path | None:
    found = (home or Path.home()).glob(f".claude*/projects/*/{session}.jsonl")
    return max(found, key=mtime, default=None)


def last_text(path: Path) -> str | None:
    with path.open("rb") as f:
        f.seek(max(0, f.seek(0, 2) - TAIL_BYTES))
        lines = f.read().split(b"\n")
    for raw in reversed(lines):
        try:
            entry = json.loads(raw)
            if entry.get("type") != "assistant":
                continue
            parts = [c["text"] for c in entry["message"]["content"] if isinstance(c, dict) and c.get("text")]
        except (ValueError, KeyError, TypeError, AttributeError):
            continue
        if parts:
            return "\n".join(parts)
    return None


def status_line(text: str) -> str | None:
    found = [m[1] for line in text.splitlines() if (m := STATUS.match(line))]
    return found[-1] if found else None


def answer_of(agent: dict) -> str | None:
    """The last answer of the agent's session, from a `herdr agent get` or `agent list` entry."""
    session = (agent.get("agent_session") or {}).get("value")
    path = transcript_path(session) if session else None
    try:
        return last_text(path) if path else None
    except OSError:
        return None


def peek(name: str, lines: int) -> str:
    data = cls.herdr("agent", "get", name, check=False)
    if "result" not in data:
        raise cls.Failed(f"herdr agent get: {(data.get('error') or {}).get('code', 'no answer')}")
    agent = data["result"]["agent"]
    session = (agent.get("agent_session") or {}).get("value")
    answer = answer_of(agent)
    out = [f"{name}: {agent.get('agent_status')}"]
    if answer is not None:
        out += [f"status: {status_line(answer) or 'none'}", f"--- last answer, last {lines} lines ---",
                *answer.splitlines()[-lines:]]
    else:
        screen = cls.screen_of(name, "visible")
        out += [f"status: {status_line(screen) or 'none'}",
                f"--- no transcript text for session {session}; visible screen, last {lines} lines ---",
                *[ln for ln in screen.splitlines() if ln.strip()][-lines:]]
    return "\n".join(out)


def main(argv: list[str]) -> int:
    if not 1 <= len(argv) <= 2 or not (len(argv) == 1 or argv[1].isdigit()):
        print("usage: agent-peek NAME [LINES]", file=sys.stderr)
        return 2
    try:
        print(peek(argv[0], int(argv[1]) if len(argv) == 2 else 20))
    except cls.Failed as e:
        print(f"agent-peek: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
