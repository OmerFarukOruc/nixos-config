#!/usr/bin/env python3
# Starts a named Claude agent in its own herdr tab, in the caller's workspace:
#   agent-start NAME --cwd DIR [--account ACCOUNT] [--model M] [--effort E] [--permission-mode MODE] [--brief FILE]
# ACCOUNT is a claude-accounts account name or a CLAUDE_CONFIG_DIR folder; the default is the caller's own
# account. The agent starts with --dangerously-skip-permissions, as Omer's `clauded` alias does, and gets one
# prompt that names FILE (its path, not its text, so a long brief never goes through argv). --permission-mode
# starts it in that mode instead, keeps bypass reachable with shift+tab, and waits until the footer shows the mode
# before the brief goes out, because a mode switched by keypresses after start raced the brief once.
# A name whose agent just exited is waited for, since herdr frees it a moment later. When any step fails after the
# tab exists, the agent that started is stopped and the tab is closed, so the same command can run again. Exits 1
# with the herdr error code. `agent-stop NAME` ends an agent this command started.
# The tab opens with --no-focus, so the view of whoever looks at herdr stays where it is.
# CLAUDE_LIMIT_SWITCH_SESSION names another herdr session than the default one; the tab then opens in the
# session's own workspace, because the caller's pane id belongs to its own session.
import argparse
import os
import re
import sys
import time
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path


def load(name: str):
    loader = SourceFileLoader(name.replace("-", "_"), str(Path(__file__).resolve().with_name(name)))
    mod = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


cls = load("claude-limit-switch")
EFFORTS = ("low", "medium", "high", "xhigh", "max")
MODE_FOOTERS = {"acceptEdits": "accept edits on", "auto": "auto mode on", "bypassPermissions": "bypass permissions on",
                "manual": "manual mode on", "dontAsk": "", "plan": "plan mode on"}
MODE_WAIT_S = 15
NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")


def resolve_account(account: str | None, dirs: dict[str, str], caller_dir: str) -> str:
    """The CLAUDE_CONFIG_DIR for the new agent; empty means the ~/.claude account."""
    if account is None:
        return caller_dir
    if account in dirs:
        return dirs[account]
    folder = account.rstrip("/")
    if folder in dirs.values():
        return folder
    raise cls.Failed(f"{account!r} is no claude-accounts account; accounts: {', '.join(dirs)}")


def caller() -> dict | None:
    """The pane and workspace this command runs in, when it runs in the herdr session it controls."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane or cls.SESSION:
        return None
    return cls.herdr("pane", "get", pane, check=False).get("result", {}).get("pane")


def stop_started(name: str, pane: str) -> None:
    if "result" in cls.herdr("agent", "get", name, check=False):
        try:
            cls.exit_claude(name, cls.claude_process(pane)[0])
        except cls.Failed as e:
            print(f"agent-start: could not stop {name} after the failed start: {e}", file=sys.stderr)


def permission_flags(mode: str | None) -> list[str]:
    if mode is None:
        return [cls.SKIP_PERMISSIONS]
    return ["--permission-mode", mode, "--allow-dangerously-skip-permissions"]


def wait_for_mode(name: str, mode: str) -> None:
    footer = MODE_FOOTERS[mode]
    if not footer:
        return
    deadline = time.time() + MODE_WAIT_S
    while footer not in cls.screen_of(name):
        if time.time() >= deadline:
            raise cls.Failed(f"{name} started, but its footer never showed {footer!r}")
        time.sleep(1)


def start(args: argparse.Namespace) -> None:
    if "result" in cls.herdr("agent", "get", args.name, check=False):
        pane = cls.herdr("agent", "get", args.name)["result"]["agent"]["pane_id"]
        try:
            cls.claude_process(pane)
        except cls.Failed:
            cls.wait_freed(args.name)
        else:
            raise cls.Failed(f"{args.name} is already running; `agent-stop {args.name}` ends it")
    config_dir = resolve_account(args.account, cls.cu.accounts() if args.account else {}, os.environ.get("CLAUDE_CONFIG_DIR", ""))
    where = caller()
    created = cls.herdr("tab", "create", "--label", args.name, "--cwd", str(args.cwd), "--no-focus",
                        *(["--workspace", where["workspace_id"]] if where else []))["result"]
    tab, pane = created["tab"]["tab_id"], created["root_pane"]["pane_id"]
    try:
        flags = [*permission_flags(args.permission_mode), *(["--model", args.model] if args.model else []),
                 *(["--effort", args.effort] if args.effort else [])]
        cls.start_claude(pane, args.name, config_dir, flags)
        if args.permission_mode:
            wait_for_mode(args.name, args.permission_mode)
        if args.brief:
            cls.herdr("agent", "prompt", args.name,
                      f"Your brief is in {args.brief.resolve()}. Read it and carry it out.")
    except BaseException:
        stop_started(args.name, pane)
        cls.herdr("tab", "close", tab, check=False)
        raise


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="agent-start", description="Start a named Claude agent in its own herdr tab.")
    ap.add_argument("name")
    ap.add_argument("--cwd", required=True, type=Path)
    ap.add_argument("--account")
    ap.add_argument("--model")
    ap.add_argument("--effort", choices=EFFORTS)
    ap.add_argument("--permission-mode", choices=tuple(MODE_FOOTERS))
    ap.add_argument("--brief", type=Path)
    args = ap.parse_args(argv)
    if not NAME.fullmatch(args.name):
        ap.error(f"NAME {args.name!r} must match {NAME.pattern}")
    if not args.cwd.is_dir():
        ap.error(f"--cwd {args.cwd} is not a folder")
    args.cwd = args.cwd.resolve()
    if args.brief and not args.brief.is_file():
        ap.error(f"--brief {args.brief} is not a file")
    try:
        start(args)
    except cls.Failed as e:
        print(f"agent-start: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
