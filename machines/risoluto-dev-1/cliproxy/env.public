# CLIProxyAPI: the non-secret half of its configuration, committed on purpose.
#
# Every value here is safe in a public repository. The API keys, the management
# key, the tailnet name of the share node and the tokens are in
# secrets/risoluto-dev-1-cliproxy.yaml (cliproxy.nix). See docs/risoluto-dev-1.md.
#
# cliproxy-up.sh sources and exports it, so Compose interpolates from the environment.

# Official image published from https://github.com/router-for-me/CLIProxyAPI/releases
# as eceasy/cli-proxy-api. The moving tag is the ask: cliproxy-update.timer pulls
# this image and recreates only the cliproxy container.
CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest
CLIPROXY_TS_IMAGE=tailscale/tailscale:latest
# Built locally by cliproxy-up.sh from tls-proxy/Dockerfile (Caddy with the Cloudflare DNS provider).
CLIPROXY_TLS_IMAGE=localhost/cliproxy-tls-proxy:latest

# Loopback only. tls-proxy reaches the API over the compose network. Do not bind
# 0.0.0.0 or the tailnet address here.
CLIPROXY_BIND=127.0.0.1
CLIPROXY_PORT=8317
# The second name of the share node, beside its ts.net name (CLIPROXY_SHARE_HOST): a public, DNS-only A record at Cloudflare to the
# node's tailnet address, so it answers only on the tailnet (docs/risoluto-dev-1.md).
CLIPROXY_PUBLIC_HOST=cliproxy.risoluto.dev
