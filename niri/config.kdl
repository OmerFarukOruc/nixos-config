// System-wide niri config. With one niri shell, niri uses it when
// ~/.config/niri/config.kdl is absent. With several, each session sets
// NIRI_CONFIG to /etc/niri/session-<shell>.kdl, which includes this file, and
// niri does not read ~/.config/niri/config.kdl.

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// The keyboard layout and the touchpad section come from host.kdl.

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
}

// Scheme colors, generated by nixosModules/desktop.nix.
include "/etc/niri/theme.kdl"

// Settings for this machine's hardware, from its own modules.
include "/etc/niri/host.kdl"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// Blur shows only through translucent pixels, so this is an allow-list of
// surfaces that are translucent. niri enables xray blur with any background
// effect, which blurs the wallpaper once and reuses it. The DMS dock is not on
// the list, because DMS requests blur for the dock's own shape. A rule that
// matched the dock's full-width surface painted a dark strip about 90 px tall
// over the bottom of the windows (observed 2026-09-21).
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#

    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^vicinae$"

    background-effect {
        blur true
    }
}

binds {
    Mod+Return { spawn "ghostty"; }
    Mod+Space { spawn "oruc-launch-app"; }
    Mod+Alt+Space { spawn "oruc-launch-command"; }
    Mod+Shift+Space { spawn "oruc-launch-ssh"; }
    Mod+Ctrl+Space { spawn "oruc-launch-file"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    XF86PowerOff { spawn "wlogout"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+W { toggle-window-floating; }

    // niri matches the key without Shift, and the Turkish layout has = only on
    // Shift+0, so these use the two keys right of 0: * narrows, - widens.
    Mod+Asterisk { set-column-width "-10%"; }
    Mod+Minus { set-column-width "+10%"; }
    Mod+Shift+Asterisk { set-window-height "-10%"; }
    Mod+Shift+Minus { set-window-height "+10%"; }

    Mod+Ctrl+Left { consume-or-expel-window-left; }
    Mod+Ctrl+Right { consume-or-expel-window-right; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+F1 { show-hotkey-overlay; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // Noctalia and DMS bind the volume and brightness keys themselves
    // (niri/shells/*.kdl); these binds serve the waybar shell.
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    // The name pattern matches amdgpu_bl* and intel_backlight and skips
    // nvidia_0, which comes first in /sys/class/backlight on a hybrid laptop
    // and wakes the RTX 4070 when touched. oruc-idle in
    // home-manager/modules/idle.nix uses the same pattern. -e4 spreads the
    // steps over a curve.
    XF86MonBrightnessUp   { spawn "brightnessctl" "-c" "backlight" "-d" "*_b*" "-e4" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "-c" "backlight" "-d" "*_b*" "-e4" "set" "5%-"; }
}

// Binds for the selected shell, from niri/shells/. On a machine with one niri
// shell, /etc/niri/shell.kdl holds them and this last include lets them
// override the binds above. On a machine with several niri shells, shell.kdl
// holds only a comment and each /etc/niri/session-<shell>.kdl includes this file
// and then its shell's binds (nixosModules/desktop.nix).
include "/etc/niri/shell.kdl"
