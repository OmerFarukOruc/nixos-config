{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_NEW_INIT": "1",
    "TMPDIR": "/tmp",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "6",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6",
    "CLAUDE_CODE_SHELL": "/run/current-system/sw/bin/bash"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "api-mapper": "user-invocable-only",
    "apk-api-mapper": "user-invocable-only",
    "quality-campaign": "off",
    "clonedeps": "on",
    "implement-spec": "on"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/stop-sound.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|worker_permission_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/stop-sound.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/bash-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/guard-main-edit.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true,
    "next-steps@claude-community": false,
    "typescript-lsp@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true,
    "impeccable@impeccable": true,
    "eli5@claude-community": true,
    "avoid-ai-writing@conorbronsdon-skills": false,
    "grill-for-unknowns@grill-for-unknowns-marketplace": false,
    "diagram-design@diagram-design": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      },
      "autoUpdate": true
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      },
      "autoUpdate": true
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      },
      "autoUpdate": true
    }
  },
  "viewMode": "focus",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 450000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    },
    "next-steps@claude-community": {
      "options": {
        "minAnswerChars": 200
      }
    }
  },
  "timeFormat": "24-hour-utc",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:scheme",
  "preferredNotifChannel": "notifications_disabled",
  "precomputeCompactionEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "workflowSizeGuideline": "large",
  "bashOutputMaxChars": 12000,
  "disableClaudeAiConnectors": true,
  "cleanupPeriodDays": 90,
  "feedbackSurveyRate": 0
}
